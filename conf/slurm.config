/*
 * Configuración SLURM compartida, incluida por los perfiles de sitio.
 */

process {
    executor       = 'slurm'
    queue          = { params.partition_cpu }
    clusterOptions = { params.account ? "-A ${params.account} --export=ALL" : '--export=ALL' }

    withLabel: gpu {
        queue = { params.partition_gpu }
        // VSC rechaza envíos de GPU sin un --nodes explícito.
        clusterOptions = {
            (params.account ? "-A ${params.account} " : '') +
            "--export=ALL --nodes=1 --ntasks=1 --gpus-per-node=1"
        }
    }
}

executor {
    queueSize       = 50
    submitRateLimit = '10/1min'
    pollInterval    = '30sec'
}
