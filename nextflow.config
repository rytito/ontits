/*
 * Configuración de ontits
 *
 * Derivada de ont16s. Cada ajuste marcado VALIDADO se obtuvo tras encontrar
 * el fallo que previene. Ver docs/GOTCHAS.md para el síntoma que cada uno
 * aborda.
 */

manifest {
    name            = 'ontits'
    author          = 'MicroAndes project — KU Leuven & Universidad Nacional del Centro del Peru (UNCP)'
    homePage        = 'https://research.kuleuven.be/portal/nl/project/3M250529'
    description     = 'ONT ITS fúngico dual-index: del basecalling con Dorado a phyloseq'
    mainScript      = 'main.nf'
    nextflowVersion = '>=26.04.0'
    version         = '1.1.0'
}

params {
    // --- selección de etapa (la sintaxis estricta eliminó -entry) ---
    step                 = 'all'

    // --- entrada / salida ---
    pod5_dir             = null
    calls_bam            = null
    fastq_dir            = null
    metadata             = null
    outdir               = 'results'

    // --- basecalling ---
    // Dorado 2.x añadió hac@v6.0.0 para R10.4.1, pero ONT no publicó
    // ningún modelo SUP v6 para esta química, así que sup (-> v5.2.0) sigue
    // siendo el más preciso.
    model                = 'sup'
    max_reads            = null
    batchsize_benchmarks = null

    // --- demultiplexado ---
    // dos diseños de librería soportados:
    //   dual_index : primers KYO2 con barcodes Golay de 12 nt (diseño
    //                original estilo Illumina); demux con cutadapt sobre
    //                la hoja assets/barcodes.tsv (16 combinaciones 4F x 4R;
    //                combinaciones no listadas = index hopping, descartadas).
    //   ont_kit    : primers KYO2 con tags universales ONT + barcodes del
    //                Rapid PCR Barcoding Kit (SQK-RPB114.24); demux con
    //                dorado y recorte tags+primers con cutadapt. Es el
    //                diseño compatible con Rapid Adapter (RA) -- ver
    //                docs/PRIMERS_ONT_RA.md.
    demux_mode           = 'dual_index'
    barcodes             = "${projectDir}/assets/barcodes.tsv"
    kit                  = 'SQK-RPB114-24'
    ont_barcode_map      = "${projectDir}/assets/ont_barcode_map.tsv"
    barcode_both_ends    = false
    // Tags universales de ONT para primers con cola (modo ont_kit).
    fwd_tag              = 'TTTCTGTTGGTGCTGATATTGC'
    rev_tag              = 'ACTTGCCTGTCGCTCTATCTTC'
    fwd_primer           = 'TAGAGGAAGTAAAAGTCGTAA'   // ITS1-F_KYO2
    rev_primer           = 'TTYRCTRCGTTCTTCATC'      // ITS2_KYO2
    // 0.15 tolera ~4 errores en el adaptador barcode+primer de 30-33 nt --
    // adecuado para lecturas sup de R10.4.1. Súbelo con cautela: los 4
    // Golay difieren en >=5 posiciones, pero el margen se come rápido.
    demux_error_rate     = 0.15
    // Cerca de la longitud completa del adaptador: exige ver el barcode Y
    // el primer, no solo un fragmento del primer.
    demux_min_overlap    = 25

    // --- filtrado ---
    min_qscore           = 10
    // El amplicón KYO2 de esta librería mide ~300 pb, así que el inserto
    // (ya sin barcodes/primers/adaptadores) queda en ~260 pb. ITS1 varía
    // biológicamente entre taxones, así que la ventana deja margen a ambos
    // lados: elimina fragmentos y concatémeros sin sesgar contra taxones
    // de ITS más corto o más largo que el pico.
    min_len              = 150
    max_len              = 600
    subsample            = 20000
    seed                 = 42
    // Umbral phyloseq. Más bajo que en 16S: las corridas ITS suelen ser
    // menos profundas y el control negativo debe quedar excluido de todos
    // modos. Ajusta tras revisar qc/reads_per_sample.tsv.
    min_reads            = 1000

    // --- taxonomía ---
    // p. ej. 'unite:/shared/databases/emu_unite_fungi'
    emu_dbs              = null

    // --- rutas del sitio (se definen en conf/site.yml) ---
    dorado_bin           = null
    dorado_models        = null
    conda_ont            = null
    conda_emu            = null
    conda_r              = null

    // --- ejecución ---
    account              = null
    partition_cpu        = 'batch'
    partition_gpu        = 'gpu'
    help                 = false
}

process {
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
    maxRetries    = 2

    // VALIDADO: la entrada POD5 es de solo lectura y grande (~90 GB).
    // Copiarla a work/ excede una cuota de scratch de 100 GB, lo que trunca
    // salidas mientras se sigue reportando éxito.
    stageInMode   = 'symlink'

    withLabel: gpu {
        cpus   = 16          // techo por GPU en wICE gpu_h100
        memory = 120.GB      // RSS pico medido: 54 GB
        time   = { 6.h * task.attempt }
    }
    withLabel: cpu_high {
        cpus   = 16
        memory = 32.GB
        time   = { 2.h * task.attempt }
    }
    withLabel: cpu_med {
        cpus   = 8
        // UNITE-fungi (~50 MB comprimida) es órdenes de magnitud más
        // pequeña que SILVA; 16 GB bastarían, pero el margen con retry
        // cubre también unite-all sin tocar la etiqueta.
        memory = { 32.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: cpu_low {
        cpus   = 2
        memory = 8.GB
        time   = { 1.h * task.attempt }
    }
}

env {
    // VALIDADO: NO definas PATH aquí. Nextflow emite los exports de `env`
    // DESPUÉS de beforeScript, así que una asignación de PATH aquí
    // sobrescribe silenciosamente lo que beforeScript haya puesto. Las rutas
    // de herramientas van solo en beforeScript.
    PYTHONNOUSERSITE = '1'
}

profiles {

    /* ---------------- ejecutores ---------------- */

    standard {
        process.executor = 'local'
    }

    slurm {
        process {
            executor       = 'slurm'
            queue          = { params.partition_cpu }
            clusterOptions = { params.account ? "-A ${params.account} --export=ALL" : '--export=ALL' }

            withLabel: gpu {
                queue = { params.partition_gpu }
                // VALIDADO: VSC rechaza envíos de GPU sin un --nodes
                // explícito. Nextflow normalmente lo deriva de `cpus`, pero
                // un override de clusterOptions reemplaza la cadena completa.
                clusterOptions = {
                    (params.account ? "-A ${params.account} " : '') +
                    "--export=ALL --nodes=1 --ntasks=1 --gpus-per-node=1"
                }
            }
        }
        executor {
            queueSize       = 50
            submitRateLimit = '10/1min'
            pollInterval    = '30sec'
        }
    }

    vsc_wice {
        params.partition_cpu = 'batch_sapphirerapids'
        params.partition_gpu = 'gpu_h100'
        includeConfig 'conf/slurm.config'
    }

    vsc_genius {
        // Solo gpu_v100. Dorado NO soporta P100/GP100.
        params.partition_cpu = 'batch'
        params.partition_gpu = 'gpu_v100'
        includeConfig 'conf/slurm.config'
        process {
            withLabel: gpu {
                cpus   = 4       // techo por GPU en gpu_v100
                memory = 80.GB
            }
        }
    }

    /* ---------------- software ---------------- */

    conda {
        // VALIDADO: en muchos clústeres `conda` y `micromamba` son
        // FUNCIONES del shell, no ejecutables, y los procesos de Nextflow
        // nunca cargan ~/.bashrc. Por eso la directiva `conda` no puede
        // encontrarlos. Pon el bin/ de cada entorno directamente en el PATH.
        conda.enabled     = false
        apptainer.enabled = false

        process {
            beforeScript = { "export PATH=${params.conda_ont}/bin:\$PATH" }

            withName: 'EMU_.*' {
                beforeScript = { "export PATH=${params.conda_emu}/bin:\$PATH" }
            }
            withName: 'BUILD_PHYLOSEQ' {
                beforeScript = { "export PATH=${params.conda_r ?: params.conda_ont}/bin:\$PATH" }
            }
            withName: 'DORADO_DEMUX' {
                beforeScript = { "export PATH=${params.dorado_bin}:${params.conda_ont}/bin:\$PATH" }
            }
            withLabel: gpu {
                beforeScript = {
                    "export PATH=${params.dorado_bin}:${params.conda_ont}/bin:\$PATH; " +
                    "export DORADO_MODELS_DIRECTORY=${params.dorado_models}"
                }
            }
        }
    }

    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.cacheDir   = System.getenv('APPTAINER_CACHEDIR') ?: "${System.getenv('HOME')}/.apptainer/cache"
        conda.enabled        = false

        process {
            // Dorado deliberadamente NO va en contenedor: el binario
            // estático incluye su propio runtime CUDA, y el passthrough de
            // GPU en un contenedor añade modos de fallo sin ganancia alguna.
            withLabel: gpu {
                container    = null
                beforeScript = {
                    "export PATH=${params.dorado_bin}:\$PATH; " +
                    "export DORADO_MODELS_DIRECTORY=${params.dorado_models}"
                }
            }
            // Dorado demux tampoco va en contenedor (binario estático).
            withName: 'DORADO_DEMUX' {
                container    = null
                beforeScript = { "export PATH=${params.dorado_bin}:\$PATH" }
            }
            // Fija estos a tags que tu grupo haya validado.
            withName: 'BAM_TO_FASTQ'   { container = 'quay.io/biocontainers/samtools:1.21--h50ea8bc_0' }
            withName: 'BAM_TO_FASTQ_BC' { container = 'quay.io/biocontainers/samtools:1.21--h50ea8bc_0' }
            withName: 'CUTADAPT_TRIM'  { container = 'quay.io/biocontainers/cutadapt:4.9--py310h4b81fae_1' }
            // La imagen de cutadapt trae el Python que ejecuta el script de demux.
            withName: 'CUTADAPT_DEMUX' { container = 'quay.io/biocontainers/cutadapt:4.9--py310h4b81fae_1' }
            withName: 'CHOPPER_FILTER' { container = 'quay.io/biocontainers/chopper:0.9.0--hdcf5f25_0' }
            withName: 'SUBSAMPLE'      { container = 'quay.io/biocontainers/seqkit:2.8.2--h9ee0642_0' }
            withName: 'READ_STATS'     { container = 'quay.io/biocontainers/seqkit:2.8.2--h9ee0642_0' }
            withName: 'EMU_.*'         { container = 'quay.io/biocontainers/emu:3.5.1--hdfd78af_0' }
            withName: 'BUILD_PHYLOSEQ' { container = 'quay.io/biocontainers/bioconductor-phyloseq:1.48.0--r44hdfd78af_0' }
        }
    }

    /* ---------------- conveniencia ---------------- */

    test {
        params.max_reads = 20000
        params.subsample = 5000
        params.min_reads = 100
    }

    debug {
        process.beforeScript = 'echo "== $HOSTNAME =="; nvidia-smi 2>/dev/null || true; echo "PATH=$PATH"'
    }
}

// Mantén work/ fuera de cuotas pequeñas. Sobrescribe con NXF_WORK.
workDir = System.getenv('NXF_WORK') ?: './work'

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";      overwrite = true }
